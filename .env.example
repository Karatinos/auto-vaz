# Copy to .env and fill in locally. Never commit the filled-in .env.
# All values are read at runtime via os.getenv() (see config.py).

# --- Model engine (OpenRouter) ---
OPENROUTER_API_KEY=

# Optional attribution headers OpenRouter uses for rankings.
OPENROUTER_REFERER=http://localhost
OPENROUTER_TITLE=auto-vaz-eval-harness

# --- Benchmark connector ---
# Base URL of the benchmark/evaluation endpoint.
EVAL_TARGET_URL=

# Token sent in the static "x-benchmark" header by the benchmark connector.
EVAL_BENCHMARK_HEADER=
